# GEMINI_API_KEY: For AI advisory rewrite (optional)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted
APP_URL="http://localhost:3000"

# FASTAPI_URL: URL of the Python FastAPI backend (for rule engine computations)
